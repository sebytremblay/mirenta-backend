# Mirenta backend environment.
#
# Copy to `.env` and fill in. `packages/schema/src/env.ts` is the source of truth and
# validates this at boot; keep the two in sync. `pnpm preflight` checks every value
# and pings each service before you spend a real pipeline run.
#
# SECRET markers flag values that must never be committed or shipped to the client.
# The four external services are Supabase, Anthropic, Exa, and AWS S3 (see DECISIONS.md).

# =============================================================================
# App / runtime
# =============================================================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# =============================================================================
# Supabase  — Postgres + Auth, and the worker host (pg_cron + edge function, D32)
# Dashboard: Project Settings > API (URL + keys), Settings > API > JWT Secret,
#            Settings > Database (connection string).
# =============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public anon key — safe for the client; the gateway uses it to verify sessions.
SUPABASE_ANON_KEY=
# SECRET. Service role key. Bypasses RLS. Worker-only; never reaches the client.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. JWT secret used to verify Supabase sessions at the gateway (human path).
SUPABASE_JWT_SECRET=
# Project ref (the subdomain in SUPABASE_URL). Used by the Supabase CLI.
SUPABASE_PROJECT_REF=
# SECRET. Direct Postgres connection string (includes the DB password). Migrations.
# Example: postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=

# =============================================================================
# Anthropic  — Claude Managed Agents (beta), Realtime mode (D7, D13)
# SDK: the standard `@anthropic-ai/sdk` (client.beta.sessions / .environments).
#      Beta header `managed-agents-2026-04-01` is set by the SDK automatically.
# The orchestration loop runs server-side in an Anthropic-managed cloud sandbox,
# so the worker only starts a session, records its id, and polls on a later tick.
# Console: https://console.anthropic.com/settings/keys
# =============================================================================
# SECRET. Creates sessions and reads queue stats. The MVP cloud-sandbox path needs
# only this key.
ANTHROPIC_API_KEY=
# Sonnet across every research phase (D35). Model is set on the Agent, not here;
# this carries the id the agent-creation code reads.
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-4-6
# Opus for the Website Builder, the customer-facing artifact (D35).
ANTHROPIC_BUILDER_MODEL=claude-opus-4-8
# realtime | batch. Realtime for the MVP; Batch is a cost fast-follow.
ANTHROPIC_API_MODE=realtime
# Self-hosted sandbox only (NOT the MVP path). Uncomment if you move tool execution
# onto your own infra; the cloud-sandbox MVP leaves both blank. The environment key
# is generated in the Console, and authenticates the worker to its queue.
# ANTHROPIC_ENVIRONMENT_ID=
# ANTHROPIC_ENVIRONMENT_KEY=   # SECRET

# =============================================================================
# Exa  — search + fetch, loaded as an MCP tool inside the agent (D6)
# Dashboard: https://dashboard.exa.ai/api-keys  (provision credits before running)
# =============================================================================
# SECRET.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# =============================================================================
# AWS S3  — published static sites at {orgId}/{jobId}/index.html (D16, D29)
# IAM user scoped to PutObject on the bucket; bucket configured for public website hosting.
# =============================================================================
AWS_REGION=us-east-1
# SECRET.
AWS_ACCESS_KEY_ID=
# SECRET.
AWS_SECRET_ACCESS_KEY=
S3_SITES_BUCKET=mirenta-sites
# Public website endpoint base. site_url = this + /{orgId}/{jobId}/index.html
# Example: http://mirenta-sites.s3-website-us-east-1.amazonaws.com
S3_PUBLIC_BASE_URL=

# =============================================================================
# Worker / durability layer  (mvp-pipeline-architecture.md)
# =============================================================================
# Attempt ceiling that bounds the retry loop (operators tune without a deploy).
MAX_JOB_ATTEMPTS=5
# Worker lease, in seconds. A tick reclaims a job whose lease has expired.
WORKER_LEASE_SECONDS=300
# How many due jobs a single tick claims (the SKIP LOCKED batch size).
WORKER_CLAIM_BATCH_SIZE=10
# SECRET. Shared secret the scheduler presents to authenticate a worker-tick call.
WORKER_TRIGGER_SECRET=
