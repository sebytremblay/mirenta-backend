# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Mirenta Backend"
VERSION=1.0.0
DEBUG=true
DEFAULT_PERSONA_NAME=Alex

# API Settings
# Mount path for all product routes (e.g. /api/organizations).
# Must match the agent's API_PREFIX (livekit_agent/.env) or bootstrap/finalize 404.
API_PREFIX=/api

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_TEMPERATURE=0.2

# Supabase Settings — Project Settings -> API
SUPABASE_URL="https://jpaadfzdzpdupcsqghxb.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWKS_URL="https://jpaadfzdzpdupcsqghxb.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase Postgres Settings — Project Settings -> Database -> Connection string (direct connection, not the pooler)
# Used by the LangGraph checkpointer (app/core/langgraph/graph.py) for its own tables.
SUPABASE_DB_HOST="db.jpaadfzdzpdupcsqghxb.supabase.co"
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD="your-database-password"  # pragma: allowlist secret

# Externally-reachable base URL for this API (newly purchased Twilio numbers
# get their SMS webhook pointed at $APP_BASE_URL$API_PREFIX/webhooks/twilio/sms and
# their voice webhook at $APP_BASE_URL$API_PREFIX/webhooks/twilio/voice)
APP_BASE_URL="http://localhost:8000"

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Temporal Settings — Temporal Cloud (docs.temporal.io/cloud) or local docker-compose
# Local dev: leave TEMPORAL_ADDRESS/TEMPORAL_TLS at their defaults (localhost:7233, false)
# Temporal Cloud: set TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233, TEMPORAL_TLS=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mirenta-runtime
TEMPORAL_TLS=false
TEMPORAL_KEY="your-temporal-key"  # pragma: allowlist secret — Temporal Cloud API key only


# Twilio Settings — Console -> Account -> API keys & tokens (parent account)
TWILIO_ACCOUNT_SID=""  # pragma: allowlist secret
TWILIO_AUTH_TOKEN=""  # pragma: allowlist secret
# Optional Fernet key for encrypting per-org subaccount Auth Tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TWILIO_TOKEN_ENCRYPTION_KEY=""

# LiveKit agent secrets live in livekit_agent/.env (LIVEKIT_URL, API key/secret,
# DEEPGRAM_*, OPENAI_*). FastAPI only needs the shared secret for agent
# bootstrap/finalize callbacks — org numbers get SMS + voice webhooks.
# LIVEKIT_AGENT_NAME defaults to mirenta-voice on the agent side.

# Shared secret for LiveKit agent → FastAPI /internal/voice/* callbacks
MIRENTA_INTERNAL_API_KEY=""  # pragma: allowlist secret

# Google Calendar OAuth — realtors connect their calendar so the voice agent can
# read availability and book meetings. Create a Web-application OAuth client in
# Google Cloud Console (APIs & Services -> Credentials) with the Calendar API
# enabled. GOOGLE_OAUTH_REDIRECT_URI must be registered on that client verbatim
# and match APP_BASE_URL; defaults to <APP_BASE_URL>/api/integrations/google/callback.
# GOOGLE_TOKEN_ENCRYPTION_KEY: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=""  # pragma: allowlist secret
GOOGLE_CLIENT_SECRET=""  # pragma: allowlist secret
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_TOKEN_ENCRYPTION_KEY=""  # pragma: allowlist secret
# Dashboard base URL the OAuth callback redirects back to (with ?google=connected|error).
WEBSITE_BASE_URL="http://localhost:3000"

# LiveKit Cloud SIP inbound trunk host (no "sip:" scheme), e.g.
# "mirenta-y0dc1n3g.sip.livekit.cloud". Find it on the LiveKit Cloud project's
# SIP settings page after creating the inbound trunk + dispatch rule (see
# livekit_agent/sip/inbound-trunk.json, dispatch-rule.json). When set, the
# Twilio voice webhook dials inbound PSTN calls into this trunk instead of
# rejecting them.
LIVEKIT_SIP_URI=""
