# =============================================================================
# Anthropic  — Claude Managed Agents (beta), Realtime mode (D7, D13)
# SDK: the standard `@anthropic-ai/sdk` (client.beta.sessions / .environments).
#      Beta header `managed-agents-2026-04-01` is set by the SDK automatically.
# The orchestration loop runs server-side in an Anthropic-managed cloud sandbox,
# so the worker only starts a session, records its id, and polls on a later tick.
# Console: https://console.anthropic.com/settings/keys
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_RESEARCH_MODEL=claude-haiku-4-5
ANTHROPIC_BUILDER_MODEL=claude-haiku-4-5
# realtime | batch. Realtime for the MVP; Batch is a cost fast-follow.
ANTHROPIC_API_MODE=realtime

# =============================================================================
# Exa  — search + fetch, loaded as an MCP tool inside the agent (D6)
# Dashboard: https://dashboard.exa.ai/api-keys  (provision credits before running)
# =============================================================================
# SECRET.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai