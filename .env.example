# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2

# Supabase Settings — Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
