# =============================================================================
# Anthropic  — the agent loop runs in-process via /v1/messages (D45, D47).
# If the key reaches the public Anthropic API, leave ANTHROPIC_BASE_URL unset.
# If it routes through a gateway, set ANTHROPIC_BASE_URL to the gateway origin.
# Models pin to a dated id for the build (D47); some gateways reject aliases.
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_RESEARCH_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BUILDER_MODEL=claude-haiku-4-5-20251001
# realtime | batch. Realtime for the MVP; Batch is a cost fast-follow.
ANTHROPIC_API_MODE=realtime

# =============================================================================
# Exa  — search + fetch, called directly from the in-process agent loop (D6)
# Dashboard: https://dashboard.exa.ai/api-keys  (provision credits before running)
# =============================================================================
# SECRET.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# =============================================================================
# Supabase  — Postgres + Auth (D19). RLS off for the MVP (D30); the publishable
# key works while RLS stays off. Swap in the service-role key before RLS lands.
# =============================================================================
SUPABASE_URL=
SUPABASE_KEY=

# =============================================================================
# AWS S3  — published one-pagers, raw public website endpoint (D16, D29).
# Credentials resolve through the standard AWS chain (env, profile, role).
# Set S3_WEBSITE_ENDPOINT to override the derived region-specific host.
# =============================================================================
AWS_REGION=us-west-1
S3_BUCKET=mirenta-mvp
# S3_WEBSITE_ENDPOINT=

# =============================================================================
# Worker durability knobs (D14; the attempt ceiling per D33)
# =============================================================================
MAX_JOB_ATTEMPTS=5
WORKER_CLAIM_BATCH_SIZE=10
WORKER_LEASE_SECONDS=300
WORKER_POLL_INTERVAL_MS=5000

# Gateway HTTP port
PORT=8080
