# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Mirenta Backend"
VERSION=1.0.0
DEBUG=true
DEFAULT_PERSONA_NAME=Alex

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini
DEFAULT_LLM_TEMPERATURE=0.2

# Supabase Settings — Project Settings -> API
SUPABASE_URL="https://jpaadfzdzpdupcsqghxb.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_JWKS_URL="https://jpaadfzdzpdupcsqghxb.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase Postgres Settings — Project Settings -> Database -> Connection string (direct connection, not the pooler)
# Used by the LangGraph checkpointer (app/core/langgraph/graph.py) for its own tables.
SUPABASE_DB_HOST="db.jpaadfzdzpdupcsqghxb.supabase.co"
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD="your-database-password"  # pragma: allowlist secret

# Externally-reachable base URL for this API (newly purchased Twilio numbers
# get their SMS webhook pointed at $APP_BASE_URL/webhooks/twilio/sms)
APP_BASE_URL="http://localhost:8000"

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Temporal Settings — Temporal Cloud (docs.temporal.io/cloud) or local docker-compose
# Local dev: leave TEMPORAL_ADDRESS/TEMPORAL_TLS at their defaults (localhost:7233, false)
# Temporal Cloud: set TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233, TEMPORAL_TLS=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mirenta-takeoff
TEMPORAL_TLS=false
TEMPORAL_KEY="your-temporal-key"  # pragma: allowlist secret — Temporal Cloud API key only


# Twilio Settings — Console -> Account -> API keys & tokens
TWILIO_ACCOUNT_SID=""  # pragma: allowlist secret
TWILIO_AUTH_TOKEN=""  # pragma: allowlist secret
APP_BASE_URL="http://localhost:8000"  # set to your ngrok https URL when testing voice/SMS webhooks locally

# Deepgram Settings — console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=""  # pragma: allowlist secret
