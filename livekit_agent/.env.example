# LiveKit Cloud project (also injected by LiveKit Cloud when deployed)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=mirenta-voice

# Must match FastAPI MIRENTA_INTERNAL_API_KEY + public API base URL
MIRENTA_API_BASE_URL=https://your-api.example.com
MIRENTA_INTERNAL_API_KEY=
API_PREFIX=/api

# Model providers (or use LiveKit Inference secrets in Cloud)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
VOICE_LLM_MODEL=gpt-4.1-mini
